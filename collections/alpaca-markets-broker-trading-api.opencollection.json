{
  "opencollection": "1.0.0",
  "info": {
    "name": "Alpaca API (Trading, Market Data, Broker) Account Broker - Trading API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "APCA-API-KEY-ID",
      "value": "{{APCA-API-KEY-ID}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Broker - Trading",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create an order for an account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.alpaca.markets/v2/trading/accounts/:account_id/orders",
            "params": [
              {
                "name": "account_id",
                "value": "",
                "type": "path",
                "description": "The brokerage account UUID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Places an order on behalf of an end-user account. Full path is https://broker-api.alpaca.markets/v1/trading/accounts/{account_id}/orders."
        }
      ]
    }
  ],
  "bundled": true
}