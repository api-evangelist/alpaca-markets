          "request": {
            "name": "Get historical crypto bars",
            "description": {
              "content": "Returns aggregate OHLCV bars for crypto pairs. Full path is https://data.alpaca.markets/v1beta3/crypto/{loc}/bars, where loc is the market location, for example us.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1beta3",
                "crypto",
                ":loc",
                "bars"
              ],
              "host": [
                "{{v1beta3-crypto-loc-bars-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "symbols",
                  "value": "<string>",
                  "description": "(Required) Comma-separated crypto pairs, for example BTC/USD,ETH/USD."
                },
                {
                  "disabled": false,
                  "key": "timeframe",
                  "value": "<string>",
                  "description": "(Required) Bar aggregation, for example 1Min, 1Hour, 1Day."
